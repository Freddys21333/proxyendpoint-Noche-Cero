{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-cancel-response.schema.json",
  "title": "JobCancelResponse",
  "description": "Respuesta de solicitud de cancelación de un trabajo.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Versión del contrato de respuesta."
    },
    "engineVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Versión semántica del motor de simulación."
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Identificador único de la petición HTTP de cancelación."
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del trabajo."
    },
    "status": {
      "type": "string",
      "enum": ["cancelled", "completed", "failed"],
      "description": "Estado del trabajo después de la solicitud de cancelación."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 de creación en UTC."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 de última actualización en UTC."
    },
    "progress": {
      "type": "object",
      "properties": {
        "replicatesTotal": {
          "type": "integer",
          "minimum": 1,
          "description": "Número total de réplicas a ejecutar."
        },
        "replicatesCompleted": {
          "type": "integer",
          "minimum": 0,
          "description": "Número de réplicas completadas exitosamente."
        },
        "replicatesFailed": {
          "type": "integer",
          "minimum": 0,
          "description": "Número de réplicas que fallaron."
        }
      },
      "required": ["replicatesTotal", "replicatesCompleted", "replicatesFailed"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "requestId",
    "jobId",
    "status",
    "createdAt",
    "updatedAt",
    "progress"
  ],
  "additionalProperties": false
}
